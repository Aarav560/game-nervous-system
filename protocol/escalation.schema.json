{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "escalation.schema.json",
  "title": "Escalation",
  "description": "Laya -> Brain when unsure, goal impossible, or drives conflict (Architecture §5, §11).",
  "type": "object",
  "required": ["bot_id", "game", "episode_id", "t", "goal_id", "reason", "summary", "fallback_action"],
  "properties": {
    "bot_id": {"type": "string"},
    "game": {"type": "string"},
    "episode_id": {"type": "string"},
    "t": {"type": "number"},
    "goal_id": {"type": "string"},
    "reason": {"enum": ["low_confidence", "small_margin", "chose_escalate", "goal_impossible", "goal_suspended", "drive_conflict", "surprise"]},
    "summary": {"type": "string", "description": "world summary for the brain"},
    "distribution": {"type": "object", "additionalProperties": {"type": "number"}},
    "fallback_action": {"type": "string", "description": "what Laya is doing while waiting"}
  }
}
